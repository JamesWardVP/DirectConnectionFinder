{
  "name": "direct-connection-finder",
  "version": "0.1.0",
  "description": "Find direct and indirect UK train routes between places, with radius search and a Tube-map style route map. Runs as a static site on GitHub Pages.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.js",
    "build:demo": "node scripts/build-demo-gtfs.js",
    "check": "node scripts/check-site.js dist",
    "serve": "python3 -m http.server 8000 --directory dist",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "leaflet": "^1.9.4"
  }
}
